generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Enums are represented as plain strings for SQLite local development.

model User {
  id        String   @id @default(uuid())
  fullName  String
  password  String?
  rank      String?
  position  String?
  squad     Squad?   @relation("SquadMembers", fields: [squadId], references: [id])
  squadId   String?
  phone     String   @unique
  role      String   @default("staff")
  status    String   @default("active")
  serviceStartDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts    ShiftAssignment[] @relation("UserAssignments")
  replacedAssignments ShiftAssignment[] @relation("UserReplacements")
  pushSubs  PushSubscription[]
  absences  Absence[] @relation("UserAbsences")
  createdAbsences Absence[] @relation("UserCreatedAbsences")
  createdShifts Shift[] @relation("UserCreatedShifts")
  leadOfSquad Squad? @relation("squadLead")
  notifications Notification[]
  auditLogs AuditLog[] @relation("actor")
}

model Squad {
  id     String @id @default(uuid())
  name   String
  lead   User?  @relation("squadLead", fields: [leadId], references: [id])
  leadId String? @unique
  members User[] @relation("SquadMembers")
}

model Shift {
  id         String @id @default(uuid())
  title      String
  type       String
  location   String?
  startAt    DateTime
  endAt      DateTime
  createdBy  User?  @relation("UserCreatedShifts", fields: [createdById], references: [id])
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id        String @id @default(uuid())
  shift     Shift  @relation(fields: [shiftId], references: [id])
  shiftId   String
  user      User   @relation("UserAssignments", fields: [userId], references: [id])
  userId    String
  isSenior  Boolean @default(false)
  status    String @default("assigned")
  replacedBy User? @relation("UserReplacements", fields: [replacedById], references: [id])
  replacedById String?
  createdAt DateTime @default(now())
  notifications Notification[]
}

model Absence {
  id         String @id @default(uuid())
  user       User   @relation("UserAbsences", fields: [userId], references: [id])
  userId     String
  type       String
  startDate  DateTime
  endDate    DateTime
  orderNumber String?
  createdBy  User?  @relation("UserCreatedAbsences", fields: [createdById], references: [id])
  createdById String?
}

model Notification {
  id                  String @id @default(uuid())
  shiftAssignment     ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id])
  shiftAssignmentId   String?
  user                User   @relation(fields: [userId], references: [id])
  userId              String
  type                String
  channel             String
  message             String
  sentAt              DateTime @default(now())
  acknowledgedAt      DateTime?
  escalatedAt         DateTime?
}

model PushSubscription {
  id         String @id @default(uuid())
  user       User   @relation(fields: [userId], references: [id])
  userId     String
  endpoint   String
  keysP256dh String
  keysAuth   String
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String @id @default(uuid())
  actor      User?  @relation("actor", fields: [actorId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String?
  diff       String?
  createdAt  DateTime @default(now())
}
